---
import Layout from '../layouts/Layout.astro';
import { BookOpen, AlertCircle, Printer, X, Check, Lock, ChevronRight, Terminal, Search, MessageSquare, PieChart } from 'lucide-react';
---

<Layout title="System Documentation - Nomade Cuisine">
    <div class="min-h-screen bg-stone-50 py-12 px-4 sm:px-6">
        <div class="max-w-4xl mx-auto">
            {/* Header */}
            <div class="mb-10 text-center">
                <div class="w-16 h-16 bg-white border border-stone-200 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm">
                    <BookOpen size={32} className="text-emerald-600" />
                </div>
                <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight mb-4">Site Documentation</h1>
                <p class="text-stone-500 font-medium text-lg max-w-2xl mx-auto">
                    Official reference guide for Nomade Cuisine's digital POS systems, hardware configurations, and automated dashboards.
                </p>
            </div>

            {/* Content Blocks */}
            <div class="space-y-8">
                
                {/* Dashboard Lock */}
                <section class="bg-white rounded-[2rem] p-8 sm:p-10 border border-stone-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <Lock size={120} />
                    </div>
                    <div class="flex items-center gap-3 mb-6 relative z-10">
                        <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center border border-amber-100">
                            <Lock size={20} className="text-amber-600" />
                        </div>
                        <h2 class="text-2xl font-black text-gray-900">1. Counter Dashboard Security</h2>
                    </div>
                    <div class="prose prose-stone prose-emerald max-w-none relative z-10">
                        <p class="text-stone-600 font-medium leading-relaxed">
                            The Counter Dashboard (<code>/counter</code>) is protected by a client-side PIN pad. This ensures that unauthorized individuals cannot interact with, accept, or reject incoming web orders while the tablet is left unattended.
                        </p>
                        <div class="bg-stone-50 border border-stone-200 rounded-xl p-4 mt-4 inline-block font-mono text-sm font-bold text-stone-700">
                            Default Security PIN: <span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded">8888</span>
                        </div>
                    </div>
                </section>

                {/* Online Store Live Toggle */}
                <section class="bg-white rounded-[2rem] p-8 sm:p-10 border border-stone-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <Check size={120} />
                    </div>
                    <div class="flex items-center gap-3 mb-6 relative z-10">
                        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center border border-blue-100">
                            <AlertCircle size={20} className="text-blue-600" />
                        </div>
                        <h2 class="text-2xl font-black text-gray-900">2. Dashboard Core Toggles</h2>
                    </div>
                    <div class="prose prose-stone prose-emerald max-w-none relative z-10 space-y-6">
                        <p class="text-stone-600 font-medium leading-relaxed">
                            Through the Settings ⚙️ icon on the top right of the Counter Dashboard, a Manager can independently control all public-facing features of the digital menu.
                        </p>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div class="bg-emerald-50/50 border border-emerald-100 rounded-2xl p-5">
                                <h3 class="flex items-center gap-2 font-black text-emerald-800 text-sm mb-2">
                                    <Check size={16} strokeWidth={3} /> Ordering
                                </h3>
                                <p class="text-[11px] text-emerald-700/80 font-medium leading-relaxed">
                                    Master switch for table orders. When disabled, customers are notified that ordering is currently paused.
                                </p>
                            </div>
                            <div class="bg-amber-50/50 border border-amber-100 rounded-2xl p-5">
                                <h3 class="flex items-center gap-2 font-black text-amber-800 text-sm mb-2">
                                    <PieChart size={16} strokeWidth={3} /> Live Polls
                                </h3>
                                <p class="text-[11px] text-amber-700/80 font-medium leading-relaxed">
                                    Control whether the active poll popup is visible to guests upon entering the digital menu.
                                </p>
                            </div>
                            <div class="bg-indigo-50/50 border border-indigo-100 rounded-2xl p-5">
                                <h3 class="flex items-center gap-2 font-black text-indigo-800 text-sm mb-2">
                                    <MessageSquare size={16} strokeWidth={3} /> Feedback
                                </h3>
                                <p class="text-[11px] text-indigo-700/80 font-medium leading-relaxed">
                                    Shows/Hides the "Rate Us" feedback engagement button in the customer menu header.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                {/* Customer Security PIN */}
                <section class="bg-white rounded-[2rem] p-8 sm:p-10 border border-stone-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <Lock size={120} />
                    </div>
                    <div class="flex items-center gap-3 mb-6 relative z-10">
                        <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center border border-indigo-100">
                            <Lock size={20} className="text-indigo-600" />
                        </div>
                        <h2 class="text-2xl font-black text-gray-900">3. Customer Security PIN</h2>
                    </div>
                    <div class="prose prose-stone prose-emerald max-w-none relative z-10 space-y-6">
                        <p class="text-stone-600 font-medium leading-relaxed">
                            To ensure only customers physically present in the restaurant can place orders, Nomade Cuisine utilizes a <strong>Daily Security PIN</strong>. This prevents "Remote Spam" where people at home scan photos of your menu and send fake orders to your kitchen.
                        </p>
                        
                        <div class="bg-stone-50 border border-stone-200 rounded-2xl overflow-hidden divide-y divide-stone-200">
                            <div class="p-6">
                                <h3 class="text-lg font-black text-gray-900 mb-3">How The System Works</h3>
                                <p class="text-stone-600 font-medium leading-relaxed text-sm font-bold">
                                    When a customer clicks "Send to Counter", they must enter the current 4-digit code.
                                </p>
                                <p class="text-stone-500 font-medium leading-relaxed text-xs mt-2">
                                    By displaying this code only on physical signage (chalkboards or printed menus), you guarantee that only guests in the building can successfully cross the order threshold.
                                </p>
                            </div>
                            <div class="p-6 bg-white border-l-4 border-indigo-500">
                                <h3 class="text-lg font-black text-indigo-900 mb-2">Updating the PIN</h3>
                                <p class="text-stone-600 font-medium leading-relaxed text-sm mb-4">
                                    You can dynamically change this PIN at any time via the <strong>Settings Drawer</strong> in the Counter Dashboard. Changes are saved instantly to the secure database.
                                </p>
                                <div class="bg-stone-50 p-3 rounded-lg border border-stone-100 text-[10px] uppercase font-black tracking-widest text-indigo-600">
                                    Recommendation: Update PIN every morning to keep the geofence fresh.
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                {/* Epson Hardware Integration */}
                <section class="bg-white rounded-[2rem] p-8 sm:p-10 border border-stone-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <Printer size={120} />
                    </div>
                    <div class="flex items-center gap-3 mb-6 relative z-10">
                        <div class="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center border border-purple-100">
                            <Printer size={20} className="text-purple-600" />
                        </div>
                        <h2 class="text-2xl font-black text-gray-900">4. Kitchen Printer Configuration</h2>
                    </div>
                    <div class="prose prose-stone prose-emerald max-w-none relative z-10 space-y-6">
                        <p class="text-stone-600 font-medium leading-relaxed">
                            The dashboard communicates directly with the **Epson TM-m30III** over the local network via ePOS-Print XML. There are two primary connection modes:
                        </p>
                        
                        <div class="bg-stone-50 border border-stone-200 rounded-2xl overflow-hidden divide-y divide-stone-200">
                            <div class="p-6">
                                <h3 class="text-lg font-black text-gray-900 mb-3">Mode 1: Direct IP Fetch</h3>
                                <p class="text-stone-600 font-medium leading-relaxed mb-1 text-sm">
                                    Data is sent directly from the tablet's browser to the printer's IP.
                                </p>
                                <p class="text-xs text-amber-600 font-bold mb-4 italic">
                                    (Requires enabling "Insecure Content" in Chrome Site Settings for this domain).
                                </p>
                            </div>

                            <div class="p-6 bg-white">
                                <h3 class="text-lg font-black text-emerald-800 mb-3 flex items-center gap-2">
                                    <Terminal size={20} /> Mode 2: Local Proxy Bridge
                                </h3>
                                <p class="text-stone-600 font-medium leading-relaxed mb-4 text-sm">
                                    This bridge securely tunnels data through <code>localhost</code> to bypass standard browser security rules.
                                </p>
                                
                                <div class="bg-emerald-50 border-2 border-emerald-100 p-4 rounded-xl flex items-center gap-4">
                                    <div class="bg-emerald-500 p-2 rounded-lg text-white">
                                        <Search size={18} />
                                    </div>
                                    <div>
                                        <h4 class="font-black text-emerald-900 text-xs mb-1 uppercase tracking-widest">Auto Printer Discovery</h4>
                                        <p class="text-[11px] text-emerald-800/80 font-medium leading-relaxed leading-tight">
                                            If the Proxy is running, use <strong>"Scan Network"</strong> in the settings to automatically find and connect to your Epson printer's IP address.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                {/* Community Engagement */}
                <section class="bg-white rounded-[2rem] p-8 sm:p-10 border border-stone-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <MessageSquare size={120} />
                    </div>
                    <div class="flex items-center gap-3 mb-6 relative z-10">
                        <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center border border-amber-100">
                            <PieChart size={20} className="text-amber-600" />
                        </div>
                        <h2 class="text-2xl font-black text-gray-900">5. Community Engagement</h2>
                    </div>
                    <div class="prose prose-stone prose-emerald max-w-none relative z-10 space-y-6">
                        <p class="text-stone-600 font-medium leading-relaxed">
                            The Nomade platform includes tools to drive engagement and gather valuable data directly from your guests.
                        </p>
                        
                        <div class="grid sm:grid-cols-2 gap-6 font-medium">
                            <div class="bg-amber-50/50 border border-amber-100 rounded-2xl p-6">
                                <h3 class="text-lg font-black text-amber-900 mb-2">Live Guest Polls</h3>
                                <p class="text-[13px] text-amber-800/80 leading-relaxed mb-4">
                                    Launch interactive polls. Results are tracked in real-time on the Dashboard and can be exported as **CSV spreadsheets** for business review.
                                </p>
                                <div class="bg-white border border-amber-200/50 rounded-xl p-3 text-[10px] uppercase font-black text-amber-600 tracking-widest text-center shadow-sm">
                                    Best for: Testing new menu specials
                                </div>
                            </div>
                            
                            <div class="bg-emerald-50/50 border border-emerald-100 rounded-2xl p-6">
                                <h3 class="text-lg font-black text-emerald-900 mb-2 text-emerald-800">Feedback Feed</h3>
                                <p class="text-[13px] text-emerald-800/80 leading-relaxed mb-4">
                                    An internal guest-opinion channel where diners can leave star ratings and private comments for management to review in real-time.
                                </p>
                                <div class="bg-white border border-emerald-200/50 rounded-xl p-3 text-[10px] uppercase font-black text-emerald-600 tracking-widest text-center shadow-sm">
                                    Privacy Built-in: Staff-only access
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
                        <div class="mt-6 bg-white border border-stone-100 rounded-2xl p-6 shadow-sm">
                            <h3 class="text-sm font-black text-stone-900 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <span class="w-2 h-2 bg-amber-500 rounded-full"></span> Finding Your Printer Device ID
                            </h3>
                            <p class="text-stone-600 font-medium leading-relaxed text-sm mb-4">
                                The <strong>Device ID</strong> (or <code>devid</code>) is a unique name used by the Epson software to route print jobs. By default, your printer is named:
                                <code class="bg-stone-50 font-bold px-2 py-1 ml-1 rounded border border-stone-200 text-indigo-600">local_printer</code>
                            </p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200">
                                    <h4 class="font-bold text-stone-800 text-xs mb-2 uppercase">A. Web Browser Method</h4>
                                    <p class="text-[11px] text-stone-500 leading-relaxed font-medium">
                                        Type the printer's IP (e.g. <code>192.168.1.106</code>) into Chrome. Look for <strong>"Device ID"</strong> under the <strong>ePOS-Print</strong> settings menu.
                                    </p>
                                </div>
                                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200">
                                    <h4 class="font-bold text-stone-800 text-xs mb-2 uppercase">B. Self-Test Method</h4>
                                    <p class="text-[11px] text-stone-500 leading-relaxed font-medium">
                                        Turn the printer off. Hold the <strong>FEED</strong> button and turn it back on. The printed slip will list the ID under <strong>ePOS-Print Details</strong>.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            {/* Footer Back Link */}
            <div class="mt-12 text-center pb-12">
                <a href="/counter" class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-stone-200 rounded-full font-bold text-stone-600 shadow-sm hover:shadow-md hover:bg-stone-50 transition-all active:scale-95 group">
                    <ChevronRight size={18} className="rotate-180 text-stone-400 group-hover:-translate-x-1 transition-transform" />
                    Back to Counter Dashboard
                </a>
            </div>
        </div>
    </div>
</Layout>
